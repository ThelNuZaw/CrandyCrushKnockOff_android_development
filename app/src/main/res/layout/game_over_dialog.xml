<?xml version="1.0" encoding="utf-8"?>
<!-- Same card, font, colors and buttons as the board (bg_board) and main menu (bg_play_button). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_board"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    tools:context=".GameOverFragment"
    tools:layout_width="340dp">

    <!-- The board's six candies as a decorative strip. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_gold" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_blue" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_orange" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_green" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_yellow" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:src="@drawable/candy_rose" />

    </LinearLayout>

    <edu.sjsu.android.candycrushknockoff.OutlineTextView
        android:id="@+id/game_over_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/fredoka_bold"
        android:includeFontPadding="false"
        android:padding="6dp"
        android:text="@string/game_over_title"
        android:textColor="@color/white"
        android:textSize="44sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/gold_divider" />

    <TextView
        android:id="@+id/game_over_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/fredoka_bold"
        android:textColor="@color/chip_text"
        android:textSize="26sp"
        tools:text="Score: 980" />

    <TextView
        android:id="@+id/game_over_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/fredoka_bold"
        android:textColor="@color/chip_text"
        android:textSize="26sp"
        tools:text="Best: 1240" />

    <!-- Only visible when this run beat the saved best. Same badge as the board's level label. -->
    <TextView
        android:id="@+id/game_over_new_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_level_badge"
        android:fontFamily="@font/fredoka_bold"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/game_over_new_best"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/gold_divider" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/game_over_play_again"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_play_button"
        android:fontFamily="@font/fredoka_bold"
        android:stateListAnimator="@null"
        android:text="@string/game_over_play_again"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="26sp"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/game_over_main_menu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_menu_button"
        android:fontFamily="@font/fredoka_bold"
        android:stateListAnimator="@null"
        android:text="@string/game_over_main_menu"
        android:textAllCaps="false"
        android:textColor="@color/chip_text"
        android:textSize="22sp"
        app:backgroundTint="@null" />

</LinearLayout>
